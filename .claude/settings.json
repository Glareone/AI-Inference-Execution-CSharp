{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(~/.cache/inference-engine/models/**)",
      "Read(~/.dotllm/**)",
      "Read(//usr/local/share/dotnet/**)",
      "Read(~/.dotnet/**)",
      "Bash(dotnet --version)",
      "Bash(dotnet --list-sdks)",
      "Bash(dotnet --list-runtimes)",
      "Bash(brew info *)",
      "Bash(brew search *)"
    ]
  }
}
