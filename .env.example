# Copy to .env (gitignored) and adjust for your machine. Every value here can also be passed
# as a CLI flag instead (e.g. --model, --prompt); explicit flags override these.

INFERENCE_MODEL=/absolute/path/to/SmolLM2-135M-Instruct-f16.gguf
INFERENCE_PROMPT=What is machine learning? Explain briefly.
INFERENCE_MAX_TOKENS=64
INFERENCE_TEMPERATURE=0
INFERENCE_TOP_K=0
INFERENCE_TOP_P=0
# INFERENCE_SEED=42
INFERENCE_RAW=false
INFERENCE_STATS=true
